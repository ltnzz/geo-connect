# Firebase web app config from Firebase Console > Project settings > Your apps.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google OAuth client IDs from Google Cloud Console. Android and iOS IDs must
# belong to com.aroundu.app. The web client must be from the same Firebase project.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Google Maps SDK key. Restrict it to the Android package and signing
# certificate in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Deployed Cloudflare Worker URL. Do not put the Foursquare API key here.
EXPO_PUBLIC_FOURSQUARE_WORKER_URL=

# Cloudinary unsigned upload config. Never put CLOUDINARY_API_SECRET in Expo.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_FOLDER=aroundu
