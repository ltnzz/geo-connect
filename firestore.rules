rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMutualConnection(userId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/follows/$(request.auth.uid + "_" + userId)
        )
        && exists(
          /databases/$(database)/documents/follows/$(userId + "_" + request.auth.uid)
        );
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid;
      allow update: if (
          isOwner(userId)
          || (
            isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'followersCount',
                'followingCount',
                'postsCount',
                'updatedAt'
              ])
          )
        )
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);

      match /pushTokens/{tokenId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /bookmarks/{postId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    match /userLocations/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    match /sharedLocations/{userId} {
      allow read: if isOwner(userId)
        || (
          isMutualConnection(userId)
          && get(
            /databases/$(database)/documents/users/$(userId)
          ).data.invisibleMode == false
          && get(
            /databases/$(database)/documents/users/$(userId)
          ).data.locationSharing in ['exact', 'neighborhood']
        );
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && get(
          /databases/$(database)/documents/users/$(userId)
        ).data.invisibleMode == false
        && get(
          /databases/$(database)/documents/users/$(userId)
        ).data.locationSharing in ['exact', 'neighborhood']
        && request.resource.data.precision == get(
          /databases/$(database)/documents/users/$(userId)
        ).data.locationSharing;
      allow delete: if isOwner(userId);
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn()
        && (
          resource.data.authorId == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'likesCount',
              'commentsCount',
              'checkinsCount',
              'updatedAt'
            ])
        );
      allow delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn()
          && resource.data.userId == request.auth.uid;
      }

      match /likes/{userId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }
    }

    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.followerId == request.auth.uid;
    }

    match /places/{placeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /checkins/{checkinId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.creatorId == request.auth.uid;

      match /registrations/{userId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isOwner(userId);
      }

      match /participants/{userId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isOwner(userId);
      }

      match /checkins/{userId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isOwner(userId);
      }

      match /stories/{storyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn()
          && resource.data.userId == request.auth.uid;
      }
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read']);
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
